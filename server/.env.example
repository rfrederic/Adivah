# Copier ce fichier vers server/.env. Ne jamais versionner le fichier .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/adivah
# Secret de signature des sessions : générez-le avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# URL publique du site (sert au SEO, au sitemap et aux contrôles d'origine)
SITE_URL=http://localhost:5173
# Nombre de proxys devant l'application (mettre 1 derrière Nginx, Render, etc.)
TRUST_PROXY=0

# E-mail (facultatif). Sans SMTP_HOST, aucune notification ni récupération de mot de passe par e-mail.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ADIVAH <no-reply@example.org>"

# Sauvegardes : dossier hors du site, et clé de chiffrement de 32 caractères minimum, conservée ailleurs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_DIR=/var/backups/adivah
# BACKUP_KEY=
# BACKUP_KEEP=14

# --- Vercel uniquement ---
# Fourni automatiquement quand un magasin Vercel Blob est relié au projet :
# les fichiers téléversés y sont alors enregistrés (sinon : dossier UPLOAD_DIR).
# BLOB_READ_WRITE_TOKEN=
# Secret de la tâche planifiée quotidienne (/api/cron/publish), au moins 16 caractères.
# CRON_SECRET=
